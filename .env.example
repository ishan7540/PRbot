# ──────────────────────────────────────────────────
# PRbøt — Environment Configuration
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────

# ── AI Provider ──────────────────────────────────
# Configure at least ONE. If both are set, OpenAI takes priority.

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ── OpenAI Model Overrides (optional) ────────────
# Defaults: gpt-5.6-luna (fast tasks), gpt-5.6-luna (code generation)
# OPENAI_MODEL_FAST=gpt-5.6-luna
# OPENAI_MODEL_SMART=gpt-5.6-luna

# ── GitHub App Credentials ───────────────────────
# Create at: https://github.com/settings/apps/new
# See LOCAL_SETUP.md for detailed instructions.

# App ID (found in GitHub App settings → General)
GITHUB_APP_ID=

# Base64-encoded private key (.pem)
# Generate: base64 -i private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=

# Database
MONGODB_URI=mongodb://localhost:27017/prbot
REDIS_URL=redis://localhost:6379

# ── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Sandbox ──────────────────────────────────────
# Docker test execution timeout in milliseconds
SANDBOX_TIMEOUT_MS=90000

# Max concurrent BullMQ workers
MAX_CONCURRENT_JOBS=2

# ── Agent Limits ─────────────────────────────────
# Max generate→run→fix iterations per PR
MAX_AGENT_ITERATIONS=3

# Max test files the agent can generate per run
MAX_TEST_FILES=10
